# URL do backend (backend-membership-area). Lida só no servidor do Next; nunca use o prefixo NEXT_PUBLIC_.
# A integração com o Sympla (token e participantes) fica no backend.
BACKEND_URL=http://localhost:3333

# Console administrativo (/admin). Ainda sem login: liberado em desenvolvimento e,
# em produção, só com ADMIN_HABILITADO=true. Expõe dados pessoais de participantes.
ADMIN_HABILITADO=
