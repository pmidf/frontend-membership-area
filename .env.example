# Token da API Pública do Sympla (Minha Conta > Integrações, na conta organizadora do PMI-DF).
# Lido só no servidor do Next. NUNCA use o prefixo NEXT_PUBLIC_: o token dá acesso aos dados
# pessoais dos participantes e às rotas de check-in.
# Obrigatório: sem ele, a agenda e o console mostram a tela de erro.
SYMPLA_TOKEN=

# Console administrativo (/admin). Ainda sem login: liberado em desenvolvimento e,
# em produção, só com ADMIN_HABILITADO=true. Expõe dados pessoais de participantes.
ADMIN_HABILITADO=

# Onde o console guarda conciliações, auditoria e log de sincronização (padrão: data/agenda-admin.json).
# Precisa de disco persistente; não funciona em ambiente serverless.
AGENDA_ADMIN_ARQUIVO=

# Diagnóstico: loga caminho, status e tempo de cada chamada ao Sympla (nunca a query nem o token).
SYMPLA_DEBUG=
